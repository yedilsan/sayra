# Base URL of the Sayra backend (backend/ runs on PORT, default 3000, no global prefix).
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time — never put secrets here.
#
# - Web / iOS simulator: http://localhost:3000
# - Android emulator:    http://10.0.2.2:3000  (emulator's alias for the host machine's localhost)
# - Physical device:     http://<your-machine-LAN-IP>:3000  (device and machine must be on the same network)
EXPO_PUBLIC_API_URL=http://localhost:3000
